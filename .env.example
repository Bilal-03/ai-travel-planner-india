# ==========================
# AI Travel Itinerary Planner — Environment Variables
# ==========================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore already.

# --- LLM (required) ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Transport (optional — app works without these) ---
# Skyscanner via RapidAPI: https://rapidapi.com/
SKYSCANNER_RAPIDAPI_KEY=your_skyscanner_rapidapi_key_here

# RailRadar: https://rapidapi.com/railradar/
RAILRADAR_API_KEY=your_railradar_api_key_here

# --- Provider selections (safe defaults preserve the current integrations) ---
# Supported current values: legacy/skyscanner, legacy/railradar, overpass,
# osrm, openweather, and none. Unsupported future choices fail closed and use
# the labelled service fallback until their adapter is implemented.
FLIGHT_PROVIDER=legacy
HOTEL_PROVIDER=none
PLACES_PROVIDER=overpass
ROUTES_PROVIDER=osrm
RAIL_PROVIDER=legacy
BUS_PROVIDER=none
WEATHER_PROVIDER=openweather

# --- Provider resilience ---
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_BACKOFF_SECONDS=0.25
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30

# --- Destination photography (optional) ---
# Unsplash: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# --- Weather (optional) ---
# OpenWeatherMap: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# --- Database (optional — falls back to in-memory) ---
# Neon: https://neon.com/ — use its pooled connection string with sslmode=require
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# --- Cache (optional — falls back to in-memory) ---
# Upstash Redis: https://upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# --- Durable trip jobs ---
# Use a long random value in production; this derives completed-job edit tokens.
TRIP_JOB_SECRET=replace_with_a_long_random_job_secret

# --- Authentication and explicit preference memory ---
# Managed deployment target: Supabase Auth. Leave AUTH_PROVIDER=local for a
# runnable local signed-session fallback when Supabase credentials are absent.
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_JWT_SECRET=
ACCOUNT_SESSION_TTL_SECONDS=2592000

# --- App ---
# Frontend URL (update to your Vercel URL after deployment)
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BACKEND_PORT=8000
